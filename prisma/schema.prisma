generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RSVPStatus {
  ATTENDING
  DECLINED
  WAITLISTED
}

model Event {
  id           String   @id @default(uuid())
  title        String
  eventDate    DateTime
  endDate      DateTime
  locationName String
  latitude     Float?
  longitude    Float?
  description  String?
  maxGuests    Int
  notes        String?
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  guests       Guest[]
}

model Guest {
  id        String     @id @default(uuid())
  eventId   String
  name      String
  status    RSVPStatus @default(ATTENDING)
  reason    String?
  createdAt DateTime   @default(now())
  event     Event      @relation(fields: [eventId], references: [id])
}
